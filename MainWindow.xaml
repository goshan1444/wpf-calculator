<Window x:Class="WpfCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCalculator"
        mc:Ignorable="d"
        Title="Калькулятор" 
        Height="500" 
        Width="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Close Button Style -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Button Style -->
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Digit Button Style (with Hover/Pressed Transitions) -->
        <Style x:Key="DigitButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#2C2C2C" CornerRadius="6" BorderBrush="#12FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Smooth Hover Animations -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#3C3C3C" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#2C2C2C" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Operator Button Style -->
        <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#333333" CornerRadius="6" BorderBrush="#18FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#454545" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#333333" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Equal Button Style -->
        <Style x:Key="EqualButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#0067C0" CornerRadius="6" BorderBrush="#30FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1875D0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#0067C0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Root Border with CornerRadius, DropShadow, BorderBrush, Background -->
        <Border CornerRadius="12" 
                Margin="10" 
                ClipToBounds="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#12FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <Border.Background>
                <!-- Fluent Acrylic Dark Theme Gradient Background -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EA202020" Offset="0.0"/>
                    <GradientStop Color="#EA161616" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <!-- Soft Drop Shadow for Floating Acrylic Depth -->
                <DropShadowEffect BlurRadius="12" 
                                  Direction="270" 
                                  Opacity="0.45" 
                                  ShadowDepth="3" 
                                  Color="#000000"/>
            </Border.Effect>

            <!-- Main Rounded Container -->
            <Border CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Title Bar -->
                        <RowDefinition Height="120"/>  <!-- Row 1: Display -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Grid of Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Custom Windows 11 Title Bar -->
                    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Height="32" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title & Icon -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="🖩" Foreground="#99FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Calculator" Foreground="#99FFFFFF" FontSize="12" FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Control Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="46" Height="32" Click="OnMinimizeClick" Style="{StaticResource TitleBarButtonStyle}">
                                <TextBlock Text="—" Foreground="#FFFFFF" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                            <Button Width="46" Height="32" Click="OnCloseClick" Style="{StaticResource TitleBarCloseButtonStyle}">
                                <TextBlock Text="✕" Foreground="#FFFFFF" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Display Area -->
                    <Grid Grid.Row="1" Background="#06FFFFFF">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Formula/History Display -->
                        <TextBlock x:Name="FormulaText" 
                                   Grid.Row="0"
                                   Text="" 
                                   Foreground="#90FFFFFF" 
                                   FontSize="13" 
                                   TextAlignment="Right" 
                                   Margin="20,10,20,4" 
                                   Height="18"
                                   FontFamily="Segoe UI Variable, Segoe UI"/>

                        <!-- Current Value Display (using Viewbox to scale long values) -->
                        <Viewbox Grid.Row="1" 
                                 HorizontalAlignment="Right" 
                                 VerticalAlignment="Bottom" 
                                 Margin="20,0,20,15"
                                 StretchDirection="DownOnly" 
                                 Stretch="Uniform">
                            <TextBlock x:Name="DisplayText" 
                                       Text="0" 
                                       Foreground="#FFFFFF" 
                                       FontSize="44" 
                                       FontWeight="SemiBold" 
                                       FontFamily="Segoe UI Variable, Segoe UI"/>
                        </Viewbox>
                    </Grid>

                    <!-- Buttons Grid -->
                    <Grid Grid.Row="2" Margin="12,8,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: C, Backspace, /, * -->
                        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="C" Style="{StaticResource OperatorButtonStyle}" Click="OnClearClick"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="⌫" Style="{StaticResource OperatorButtonStyle}" Click="OnBackspaceClick"/>
                        <Button Grid.Row="0" Grid.Column="3" Content="∕" Style="{StaticResource OperatorButtonStyle}" Click="OnOperatorClick"/>

                        <!-- Row 1: 7, 8, 9, * -->
                        <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="×" Style="{StaticResource OperatorButtonStyle}" Click="OnOperatorClick"/>

                        <!-- Row 2: 4, 5, 6, - -->
                        <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="2" Grid.Column="3" Content="−" Style="{StaticResource OperatorButtonStyle}" Click="OnOperatorClick"/>

                        <!-- Row 3: 1, 2, 3, + -->
                        <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="3" Grid.Column="3" Content="+" Style="{StaticResource OperatorButtonStyle}" Click="OnOperatorClick"/>

                        <!-- Row 4: 0, , , = -->
                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Style="{StaticResource DigitButtonStyle}" Click="OnDigitClick"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="," Style="{StaticResource DigitButtonStyle}" Click="OnDecimalClick"/>
                        <Button Grid.Row="4" Grid.Column="3" Content="=" Style="{StaticResource EqualButtonStyle}" Click="OnEqualClick"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>